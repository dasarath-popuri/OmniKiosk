<Window x:Class="OmniKiosk.Wpf.Controls.CustomAmountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Height="Auto"
        Width="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height">

    <Window.Resources>
        <Style x:Key="KeypadButton" TargetType="Button">
            <Setter Property="Height" Value="72"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E7EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="20" Padding="36" BorderThickness="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Enter Amount" FontSize="26" FontWeight="Bold" Foreground="#1F2937" HorizontalAlignment="Center" Margin="0,0,0,24"/>

            <!-- Display area with embedded clear button -->
            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="2" CornerRadius="16" Padding="20,16" Margin="0,0,0,24">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="CurrencyPrefixText" FontSize="32" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock x:Name="AmountDisplayText" Text="0" FontSize="48" FontWeight="Black" Foreground="#111827" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Content="✕" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="#9CA3AF" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Clear_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#EF4444"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <TextBlock x:Name="ErrorText" Foreground="#EF4444" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,16" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"/>

            <!-- Numeric keypad: ATM Layout -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Content="7" Style="{StaticResource KeypadButton}" Click="Digit_Click" Tag="7"/>
                <Button Grid.Row="0" Grid.Column="1" Content="8" Style="{StaticResource KeypadButton}" Click="Digit_Click" Tag="8"/>
                <Button Grid.Row="0" Grid.Column="2" Content="9" Style="{StaticResource KeypadButton}" Click="Digit_Click" Tag="9"/>

                <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource KeypadButton}" Click="Digit_Click" Tag="4"/>
                <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource KeypadButton}" Click="Digit_Click" Tag="5"/>
                <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource KeypadButton}" Click="Digit_Click" Tag="6"/>

                <Button Grid.Row="2" Grid.Column="0" Content="1" Style="{StaticResource KeypadButton}" Click="Digit_Click" Tag="1"/>
                <Button Grid.Row="2" Grid.Column="1" Content="2" Style="{StaticResource KeypadButton}" Click="Digit_Click" Tag="2"/>
                <Button Grid.Row="2" Grid.Column="2" Content="3" Style="{StaticResource KeypadButton}" Click="Digit_Click" Tag="3"/>

                <Button Grid.Row="3" Grid.Column="0" Content="." Style="{StaticResource KeypadButton}" Click="Decimal_Click"/>
                <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource KeypadButton}" Click="Digit_Click" Tag="0"/>
                <Button Grid.Row="3" Grid.Column="2" Content="⌫" Style="{StaticResource KeypadButton}" Background="#FEE2E2" Foreground="#DC2626" Click="Backspace_Click"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button x:Name="CancelButton" Grid.Column="0" Content="Cancel" Background="White" Foreground="#4B5563" FontSize="20" FontWeight="Bold" Height="68" BorderThickness="2" BorderBrush="#E5E7EB" Cursor="Hand" Margin="0,0,8,0" Click="CancelButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="ConfirmButton" Grid.Column="1" Content="Confirm" Background="#2563EB" Foreground="White" FontSize="20" FontWeight="Bold" Height="68" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0" Click="ConfirmButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>