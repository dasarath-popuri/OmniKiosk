<Window x:Class="OmniKiosk.Wpf.Views.Admin.MaintenancePinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Controls"
        Width="520"
        Height="690"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>

        <Style x:Key="PinButtonStyle"
               TargetType="Button">
            <Setter Property="Margin"
                    Value="6"/>
            <Setter Property="FontSize"
                    Value="26"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Background"
                    Value="#F2F2F2"/>
            <Setter Property="Foreground"
                    Value="#111111"/>
        </Style>

        <Style x:Key="PinSecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PinButtonStyle}">
            <Setter Property="FontSize"
                    Value="17"/>
            <Setter Property="Background"
                    Value="#44484A"/>
            <Setter Property="Foreground"
                    Value="White"/>
        </Style>

    </Window.Resources>

    <Border Background="#181A1B"
            BorderBrush="#2E817B"
            BorderThickness="2"
            CornerRadius="22"
            Padding="28">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="ADMIN CONTROLS"
                       Foreground="White"
                       FontSize="30"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Grid.Row="1"
                       Text="Enter the 6-digit maintenance PIN"
                       Foreground="#B8C5C2"
                       FontSize="17"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,20"/>

            <Border Grid.Row="2"
                    Background="#101213"
                    BorderBrush="#3C4745"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,20">

                <PasswordBox x:Name="PinBox"
                             MaxLength="6"
                             FontSize="34"
                             Foreground="White"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Center"
                             PasswordChar="●"/>

            </Border>

            <UniformGrid Grid.Row="3"
                         Columns="3"
                         Rows="4"
                         Margin="0,0,0,18">

                <Button Content="1" Tag="1"
                        Click="Digit_Click"
                        Style="{StaticResource PinButtonStyle}"/>
                <Button Content="2" Tag="2"
                        Click="Digit_Click"
                        Style="{StaticResource PinButtonStyle}"/>
                <Button Content="3" Tag="3"
                        Click="Digit_Click"
                        Style="{StaticResource PinButtonStyle}"/>

                <Button Content="4" Tag="4"
                        Click="Digit_Click"
                        Style="{StaticResource PinButtonStyle}"/>
                <Button Content="5" Tag="5"
                        Click="Digit_Click"
                        Style="{StaticResource PinButtonStyle}"/>
                <Button Content="6" Tag="6"
                        Click="Digit_Click"
                        Style="{StaticResource PinButtonStyle}"/>

                <Button Content="7" Tag="7"
                        Click="Digit_Click"
                        Style="{StaticResource PinButtonStyle}"/>
                <Button Content="8" Tag="8"
                        Click="Digit_Click"
                        Style="{StaticResource PinButtonStyle}"/>
                <Button Content="9" Tag="9"
                        Click="Digit_Click"
                        Style="{StaticResource PinButtonStyle}"/>

                <Button Content="CLEAR"
                        Click="Clear_Click"
                        Style="{StaticResource PinSecondaryButtonStyle}"/>

                <Button Content="0" Tag="0"
                        Click="Digit_Click"
                        Style="{StaticResource PinButtonStyle}"/>

                <Button Content="⌫"
                        Click="Backspace_Click"
                        Style="{StaticResource PinSecondaryButtonStyle}"/>

            </UniformGrid>

            <StackPanel Grid.Row="4">

                <TextBlock x:Name="ErrorText"
                           Foreground="#FF7676"
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MinHeight="24"
                           Margin="0,0,0,10"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="CANCEL"
                            Height="54"
                            FontSize="17"
                            Click="Cancel_Click"/>

                    <Button x:Name="ValidateButton"
                            Grid.Column="2"
                            Content="VALIDATE PIN"
                            Height="54"
                            FontSize="17"
                            FontWeight="Bold"
                            Background="#2E817B"
                            Foreground="White"
                            Click="Validate_Click"/>

                </Grid>

            </StackPanel>

        </Grid>

    </Border>

</Window>