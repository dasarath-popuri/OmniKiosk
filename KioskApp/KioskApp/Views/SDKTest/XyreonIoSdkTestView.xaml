<UserControl x:Class="OmniKiosk.Wpf.Views.SDKTest.XyreonIoSdkTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F0F11"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <!-- =========================================================
         RESOURCES MUST COME BEFORE THE VISUAL CONTENT
         ========================================================= -->
    <UserControl.Resources>

        <Style x:Key="InputTextStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#2C2C2E"/>

            <Setter Property="Padding"
                    Value="15"/>

            <Setter Property="Margin"
                    Value="5"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="TextAlignment"
                    Value="Center"/>

        </Style>

        <Style x:Key="IoButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="55"/>

            <Setter Property="Margin"
                    Value="5"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="8"/>

        </Style>

        <Style x:Key="DangerIoButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource IoButtonStyle}">

            <Setter Property="Background"
                    Value="#8B1E1E"/>

            <Setter Property="Foreground"
                    Value="White"/>

        </Style>

        <Style x:Key="WarningIoButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource IoButtonStyle}">

            <Setter Property="Background"
                    Value="#A65F00"/>

            <Setter Property="Foreground"
                    Value="White"/>

        </Style>

    </UserControl.Resources>

    <!-- =========================================================
         CONTENT
         ========================================================= -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="30">

            <TextBlock Text="XYREON I/O TEST"
                       Foreground="White"
                       FontSize="36"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="RP2040_0812 • DI0-DI7 • DO0-DO11"
                       Foreground="#A0A0A5"
                       FontSize="15"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

            <TextBlock x:Name="TxtConnection"
                       Text="Disconnected"
                       Foreground="Orange"
                       FontSize="18"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,5"/>

            <!-- ===============================================
                 LOWER DOOR
                 =============================================== -->

            <Border Background="#1C1C1E"
                    BorderBrush="#343438"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="18"
                    Margin="0,10">

                <StackPanel>

                    <TextBlock Text="LOWER DOOR SECURITY"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="TxtDoor"
                               Text="DI0 Door: Unknown"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0">

                        <Button Content="CONNECT / REFRESH"
                                Width="220"
                                Style="{StaticResource IoButtonStyle}"
                                Click="Connect_Click"/>

                        <Button x:Name="BtnAlarmAuto"
                                Content="START DOOR ALARM AUTO"
                                Width="260"
                                Style="{StaticResource DangerIoButtonStyle}"
                                Click="AlarmAuto_Click"/>

                    </StackPanel>

                </StackPanel>

            </Border>

            <!-- ===============================================
                 DIGITAL INPUTS
                 =============================================== -->

            <TextBlock Text="DIGITAL INPUTS"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,25,0,10"/>

            <TextBlock Text="DI0 is confirmed as the lower-door sensor. DI1-DI7 are currently unidentified."
                       Foreground="#A0A0A5"
                       FontSize="14"
                       Margin="0,0,0,8"/>

            <UniformGrid Columns="4">

                <TextBlock x:Name="DI0"
                           Text="DI0 ?"
                           Style="{StaticResource InputTextStyle}"/>

                <TextBlock x:Name="DI1"
                           Text="DI1 ?"
                           Style="{StaticResource InputTextStyle}"/>

                <TextBlock x:Name="DI2"
                           Text="DI2 ?"
                           Style="{StaticResource InputTextStyle}"/>

                <TextBlock x:Name="DI3"
                           Text="DI3 ?"
                           Style="{StaticResource InputTextStyle}"/>

                <TextBlock x:Name="DI4"
                           Text="DI4 ?"
                           Style="{StaticResource InputTextStyle}"/>

                <TextBlock x:Name="DI5"
                           Text="DI5 ?"
                           Style="{StaticResource InputTextStyle}"/>

                <TextBlock x:Name="DI6"
                           Text="DI6 ?"
                           Style="{StaticResource InputTextStyle}"/>

                <TextBlock x:Name="DI7"
                           Text="DI7 ?"
                           Style="{StaticResource InputTextStyle}"/>

            </UniformGrid>

            <!-- ===============================================
                 DIGITAL OUTPUTS
                 =============================================== -->

            <TextBlock Text="DIGITAL OUTPUTS"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,25,0,5"/>

            <TextBlock Text="Click each output to toggle ON / OFF. Use extra care with DO5 and DO6."
                       Foreground="#FFB340"
                       FontSize="14"
                       Margin="0,0,0,10"/>

            <UniformGrid Columns="3">

                <Button x:Name="DO0"
                        Tag="0"
                        Content="DO0 Printer LED"
                        Style="{StaticResource IoButtonStyle}"
                        Click="Output_Click"/>

                <Button x:Name="DO1"
                        Tag="1"
                        Content="DO1 Passport LED"
                        Style="{StaticResource IoButtonStyle}"
                        Click="Output_Click"/>

                <Button x:Name="DO2"
                        Tag="2"
                        Content="DO2 Dispenser LED"
                        Style="{StaticResource IoButtonStyle}"
                        Click="Output_Click"/>

                <Button x:Name="DO3"
                        Tag="3"
                        Content="DO3 Acceptor LED"
                        Style="{StaticResource IoButtonStyle}"
                        Click="Output_Click"/>

                <Button x:Name="DO4"
                        Tag="4"
                        Content="DO4 MyKad LED"
                        Style="{StaticResource IoButtonStyle}"
                        Click="Output_Click"/>

                <Button x:Name="DO5"
                        Tag="5"
                        Content="DO5 SIREN"
                        Style="{StaticResource DangerIoButtonStyle}"
                        Click="Output_Click"/>

                <Button x:Name="DO6"
                        Tag="6"
                        Content="DO6 ELECTRONIC LOCK"
                        Style="{StaticResource WarningIoButtonStyle}"
                        Click="Output_Click"/>

                <Button x:Name="DO7"
                        Tag="7"
                        Content="DO7 Camera White LED"
                        Style="{StaticResource IoButtonStyle}"
                        Click="Output_Click"/>

                <Button x:Name="DO8"
                        Tag="8"
                        Content="DO8 Unknown"
                        Style="{StaticResource WarningIoButtonStyle}"
                        Click="Output_Click"/>

                <Button x:Name="DO9"
                        Tag="9"
                        Content="DO9 Unknown"
                        Style="{StaticResource WarningIoButtonStyle}"
                        Click="Output_Click"/>

                <Button x:Name="DO10"
                        Tag="10"
                        Content="DO10 Unknown"
                        Style="{StaticResource WarningIoButtonStyle}"
                        Click="Output_Click"/>

                <Button x:Name="DO11"
                        Tag="11"
                        Content="DO11 Unknown"
                        Style="{StaticResource WarningIoButtonStyle}"
                        Click="Output_Click"/>

            </UniformGrid>

            <!-- ===============================================
                 RAW STATE
                 =============================================== -->

            <Border Background="#1C1C1E"
                    BorderBrush="#343438"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,20,0,10">

                <TextBlock x:Name="TxtRaw"
                           Text="DI mask: --   DO mask: ---"
                           FontFamily="Consolas"
                           Foreground="LightGray"
                           FontSize="16"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>

            </Border>

            <Button Content="BACK"
                    Width="250"
                    Height="55"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,20"
                    Style="{StaticResource IoButtonStyle}"
                    Click="Back_Click"/>

        </StackPanel>

    </ScrollViewer>

</UserControl>