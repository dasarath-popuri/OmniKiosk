<UserControl x:Class="OmniKiosk.Wpf.Views.MoneyExchange.Steps.FaceVerificationStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OmniKiosk.Wpf.Views.SDKTest"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             Background="{StaticResource BackgroundBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid Margin="60,20">

        <Grid.RowDefinitions>
            <!-- Camera + text area -->
            <RowDefinition Height="*"/>

            <!-- Navigation always at bottom -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ============================================================
         TOP CONTENT
         Camera on top, text/status underneath
         ============================================================ -->

        <Grid Grid.Row="0">

            <Grid.RowDefinitions>
                <!-- Camera -->
                <RowDefinition Height="480"/>

                <!-- Text / instructions -->
                <RowDefinition Height="Auto"/>

                <!-- Remaining empty space -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ========================================================
             CAMERA PREVIEW
             ======================================================== -->

            <Grid Grid.Row="0"
              Width="640"
              Height="480"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Background="Black">

                <!-- JPEG-pull display: CALLBACK_EVENT_PREVIEW -> ECF_CopyFrameWithAlpha
                     -> BitmapImage -> this Image.Source. No native HWND hosting -
                     matches the JpegPull_net7 reference project, which ran smoothly
                     on the actual kiosk hardware with SsDuck_model.dat present;
                     ECF_SetDisplayWindowEx (the previous approach here) did not. -->
                <Image x:Name="VisImage"
                Width="640"
                Height="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Stretch="Uniform"
                Focusable="False"/>

            </Grid>


            <!-- ========================================================
             HEADER / INSTRUCTIONS / STATUS
             DIRECTLY BELOW CAMERA
             ======================================================== -->

            <StackPanel Grid.Row="1"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center">

                <!-- Header -->

                <TextBlock x:Name="Hdr"
                       Style="{StaticResource HeaderText}"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>

                <TextBlock x:Name="SubtitleText"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeSmall}"
                       Margin="0,6,0,12"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>


                <!-- Branch-specific instructions -->

                <Border x:Name="InstructionsBanner"
                    Background="{StaticResource PrimarySurfaceBrush}"
                    CornerRadius="14"
                    Padding="20,12"
                    MaxWidth="800"
                    HorizontalAlignment="Center">

                    <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                        <TextBlock x:Name="InstructionsIcon"
                               FontSize="28"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center"/>

                        <StackPanel>

                            <TextBlock x:Name="InstructionsTitle"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                            <TextBlock x:Name="InstructionsBody"
                                   FontSize="16"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="680"
                                   Margin="0,3,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </Border>


                <!-- Status -->

                <Border Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,12"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0">

                    <StackPanel>

                        <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontSize="24"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                        <TextBlock x:Name="HintText"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="18"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Grid>


        <!-- ============================================================
         NAVIGATION
         ALWAYS AT BOTTOM
         ============================================================ -->

        <Grid Grid.Row="1"
          Margin="0,20,0,0"
          Height="80"
          VerticalAlignment="Bottom">

            <Button x:Name="BtnSkipBack"
                Width="220"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Click="Back_Click"
                Style="{StaticResource OutlineButton}"/>

            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

                <Button x:Name="BtnSkip"
                    Width="320"
                    Margin="0,0,20,0"
                    Visibility="Collapsed"
                    Click="Skip_Click"
                    Style="{StaticResource PrimaryButton}"
                    Background="{StaticResource WarningBrush}"/>

                <Button x:Name="BtnRetry"
                    Width="280"
                    Click="Retry_Click"
                    Style="{StaticResource PrimaryButton}"/>

            </StackPanel>

        </Grid>


        <!-- ============================================================
         SUCCESS POPUP
         ============================================================ -->

        <Popup x:Name="WelcomePopup"
           Placement="Center"
           AllowsTransparency="True"
           IsOpen="False">

            <Border Background="#CC0E4B43"
                CornerRadius="24"
                Padding="60">

                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text="✅"
                           FontSize="124"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                    <TextBlock x:Name="WelcomeTitle"
                           Foreground="White"
                           FontSize="46"
                           FontWeight="Black"
                           TextAlignment="Center"/>

                    <TextBlock x:Name="WelcomeName"
                           Foreground="#CFE3E0"
                           FontSize="36"
                           Margin="0,16,0,0"
                           TextAlignment="Center"/>

                </StackPanel>

            </Border>

        </Popup>


        <!-- ============================================================
         FAILURE POPUP
         ============================================================ -->

        <Popup x:Name="FailPopup"
           Placement="Center"
           AllowsTransparency="True"
           IsOpen="False">

            <Border Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource DangerBrush}"
                BorderThickness="4"
                CornerRadius="24"
                Padding="60"
                Width="760">

                <StackPanel HorizontalAlignment="Center">

                    <TextBlock Text="⚠️"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="104"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                    <TextBlock x:Name="FailTitle"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="40"
                           FontWeight="Black"
                           TextAlignment="Center"/>

                    <TextBlock x:Name="FailBody"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="24"
                           Margin="0,20,0,36"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                    <Button x:Name="FailAcknowledgeButton"
                        Width="320"
                        Height="72"
                        Click="FailAcknowledge_Click"
                        Style="{StaticResource PrimaryButton}"
                        Background="{StaticResource DangerBrush}"/>

                </StackPanel>

            </Border>

        </Popup>

    </Grid>
