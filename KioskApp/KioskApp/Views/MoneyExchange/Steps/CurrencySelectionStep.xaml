<UserControl x:Class="OmniKiosk.Wpf.Views.MoneyExchange.Steps.CurrencySelectionStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             Loaded="UserControl_Loaded" Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- Touch-friendly ATM style tile for preset amounts -->
        <Style x:Key="AmountPresetButton" TargetType="Button">
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimarySurfaceBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="60,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,28" HorizontalAlignment="Center">
            <TextBlock x:Name="TitleText" Style="{StaticResource HeaderText}" TextAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock x:Name="SubtitleText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="LstCurrencies">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Bd" Style="{StaticResource Card}" Width="220" Height="240" Margin="12"
                                Tag="{Binding}" MouseDown="CurrencyCard_MouseDown" Cursor="Hand">
                            <StackPanel VerticalAlignment="Center">
                                <!-- Restored to SharpVectors svgc:SvgViewbox -->
                                <Border Width="72" Height="52" CornerRadius="8" ClipToBounds="True" Background="{StaticResource BackgroundBrush}" BorderThickness="2" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,14" HorizontalAlignment="Center">
                                    <svgc:SvgViewbox Source="{Binding FlagUri}" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="{Binding Code}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding CountryName}" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,14" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="170"/>
                                <Border Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="10,6">
                                    <TextBlock Text="{Binding RateDisplay}" Style="{StaticResource DataMono}" FontSize="16" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Loading & Error States -->
        <StackPanel x:Name="LoadingPanel" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="⏳" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock Text="Loading currencies..." FontSize="{StaticResource FontSizeNormal}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel x:Name="ErrorPanel" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
            <TextBlock Text="⚠️" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock Text="Couldn't load currencies right now." FontSize="{StaticResource FontSizeNormal}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
            <TextBlock Text="Please try again, or ask a member of staff for assistance." FontSize="{StaticResource FontSizeSmall}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,20"/>
            <Button x:Name="BtnRetryLoad" Content="Try Again" Width="240" Click="BtnRetryLoad_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>

        <!-- AMOUNT ENTRY PANEL (Redesigned) -->
        <Border x:Name="AmountEntryPanel" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource Card}" Padding="40,32" Margin="0,20,0,0" HorizontalAlignment="Center" MinWidth="680">
            <StackPanel>
                <TextBlock x:Name="AmountEntryLabel" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <!-- Denomination Grid -->
                <UniformGrid x:Name="PresetAmountsGrid" Columns="4" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <Button x:Name="BtnOtherAmount" Height="64" FontSize="18" FontWeight="Bold" Content="Or enter a custom amount..." Style="{StaticResource OutlineButton}" Click="BtnOtherAmount_Click" Margin="8,0,8,24"/>

                <!-- Selected & Rounded Amount Display -->
                <Border x:Name="SelectedAmountPanel" Visibility="Collapsed" Background="{StaticResource PrimarySurfaceBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" CornerRadius="12" Padding="24" Margin="8,0,8,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="You selected" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock x:Name="SelectedForeignAmountText" FontSize="28" FontWeight="Black" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="RawMyrText" FontSize="20" Foreground="{StaticResource TextSecondaryBrush}" TextDecorations="Strikethrough" Margin="0,0,12,0" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                            <TextBlock x:Name="RoundedMyrText" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="Black" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <!-- Clean info box for rounding -->
                        <Border x:Name="RoundingNotePanel" Background="#E8F4FD" BorderBrush="#BAE0FF" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,16,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="ℹ️" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RoundingNoteText" FontSize="14" FontWeight="SemiBold" Foreground="#0050A0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Limit Check Warning Panel -->
                <Border x:Name="AmountLimitWarningPanel" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="2" CornerRadius="12" Padding="20" Margin="8,16,8,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️" FontSize="28" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AmountLimitWarningText" FontSize="15" FontWeight="SemiBold" Foreground="#991B1B" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="500"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,28,0,0">
            <Button x:Name="BtnBack" Width="220" HorizontalAlignment="Left" Click="Back_Click" Style="{StaticResource OutlineButton}"/>
            <Button x:Name="BtnNext" Width="280" HorizontalAlignment="Right" IsEnabled="False" Click="Next_Click" Style="{StaticResource PrimaryButton}"/>
        </Grid>
    </Grid>
</UserControl>
