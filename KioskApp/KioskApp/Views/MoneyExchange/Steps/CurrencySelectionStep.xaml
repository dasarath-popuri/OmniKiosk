<UserControl x:Class="OmniKiosk.Wpf.Views.MoneyExchange.Steps.CurrencySelectionStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             Loaded="UserControl_Loaded"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="AmountPresetButton" TargetType="Button">
            <Setter Property="Height" Value="100"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySurfaceBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="54,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24" HorizontalAlignment="Center">
            <TextBlock x:Name="TitleText"
                       Style="{StaticResource HeaderText}"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="SubtitleText"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="{StaticResource FontSizeSmall}"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="820"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Portrait scrolling content -->
        <ScrollViewer x:Name="MainScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- Currency grid -->
                <ItemsControl x:Name="LstCurrencies">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Bd"
                                    Style="{StaticResource Card}"
                                    Width="210"
                                    Height="220"
                                    Margin="10"
                                    Tag="{Binding}"
                                    MouseDown="CurrencyCard_MouseDown"
                                    Cursor="Hand">

                                <StackPanel VerticalAlignment="Center">
                                    <Border Width="72"
                                            Height="50"
                                            CornerRadius="8"
                                            ClipToBounds="True"
                                            Background="{StaticResource BackgroundBrush}"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            Margin="0,0,0,12"
                                            HorizontalAlignment="Center">
                                        <svgc:SvgViewbox Source="{Binding FlagUri}" Stretch="UniformToFill"/>
                                    </Border>

                                    <TextBlock Text="{Binding Code}"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="28"
                                               FontWeight="Black"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding CountryName}"
                                               FontSize="15"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="170"
                                               Margin="0,2,0,12"/>

                                    <Border Background="{StaticResource PrimarySurfaceBrush}"
                                            CornerRadius="8"
                                            Padding="10,6">
                                        <TextBlock Text="{Binding RateDisplay}"
                                                   Style="{StaticResource DataMono}"
                                                   FontSize="15"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Amount area appears after currency selection -->
                <Border x:Name="AmountEntryPanel"
                        Visibility="Collapsed"
                        Style="{StaticResource Card}"
                        Padding="32"
                        Margin="10,26,10,10"
                        HorizontalAlignment="Center"
                        MaxWidth="820">

                    <StackPanel>

                        <!-- Selected currency -->
                        <Border Background="{StaticResource BackgroundBrush}"
                                CornerRadius="14"
                                Padding="20,14"
                                Margin="0,0,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Selected currency"
                                               FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="SelectedCurrencyText"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="26"
                                               FontWeight="Black"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <TextBlock x:Name="SelectedRateText"
                                           Grid.Column="1"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="AmountEntryLabel"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>

                        <TextBlock Text="Choose your target amount. If some notes cannot be accepted later, you can still finish with the amount successfully accepted."
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="680"
                                   HorizontalAlignment="Center"
                                   Margin="20,7,20,18"/>

                        <!-- 2 x 2 portrait-friendly presets -->
                        <UniformGrid x:Name="PresetAmountsGrid"
                                     Columns="2"
                                     Margin="-8,0,-8,12"/>

                        <Button x:Name="BtnOtherAmount"
                                Height="62"
                                Content="Enter another amount"
                                FontSize="18"
                                FontWeight="Bold"
                                Style="{StaticResource OutlineButton}"
                                Click="BtnOtherAmount_Click"
                                Margin="0,4,0,20"/>

                        <!-- Selection summary -->
                        <Border x:Name="SelectedAmountPanel"
                                Visibility="Collapsed"
                                Background="{StaticResource PrimarySurfaceBrush}"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                BorderThickness="2"
                                CornerRadius="16"
                                Padding="24">

                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Your target"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock x:Name="SelectedForeignAmountText"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="34"
                                           FontWeight="Black"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,3,0,16"/>

                                <TextBlock Text="Estimated MYR payout"
                                           FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock x:Name="RoundedMyrText"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="40"
                                           FontWeight="Black"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,3,0,0"/>

                                <TextBlock x:Name="RawMyrText"
                                           Visibility="Collapsed"
                                           FontSize="15"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,7,0,0"/>

                                <Border x:Name="RoundingNotePanel"
                                        Visibility="Collapsed"
                                        Background="#E8F4FD"
                                        BorderBrush="#BAE0FF"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,8"
                                        Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ℹ️" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="RoundingNoteText"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0050A0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AmountLimitWarningPanel"
                                Background="#FEF2F2"
                                BorderBrush="#FECACA"
                                BorderThickness="2"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,16,0,0"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠️" FontSize="26" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AmountLimitWarningText"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#991B1B"
                                           TextWrapping="Wrap"
                                           MaxWidth="620"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading -->
        <StackPanel x:Name="LoadingPanel"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="⏳" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock Text="Loading currencies..."
                       FontSize="{StaticResource FontSizeNormal}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Error -->
        <StackPanel x:Name="ErrorPanel"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="600">
            <TextBlock Text="⚠️" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock Text="Couldn't load currencies right now."
                       FontSize="{StaticResource FontSizeNormal}"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Please try again, or ask a member of staff for assistance."
                       FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,8,0,20"/>
            <Button x:Name="BtnRetryLoad"
                    Content="Try Again"
                    Width="240"
                    Click="BtnRetryLoad_Click"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>

        <!-- Fixed portrait footer -->
        <Grid Grid.Row="2" Margin="0,22,0,0">
            <Button x:Name="BtnBack"
                    Width="220"
                    HorizontalAlignment="Left"
                    Click="Back_Click"
                    Style="{StaticResource OutlineButton}"/>

            <Button x:Name="BtnNext"
                    Width="300"
                    HorizontalAlignment="Right"
                    IsEnabled="False"
                    Click="Next_Click"
                    Style="{StaticResource PrimaryButton}"/>
        </Grid>
    </Grid>
</UserControl>