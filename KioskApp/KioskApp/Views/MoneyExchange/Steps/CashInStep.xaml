<UserControl x:Class="OmniKiosk.Wpf.Views.MoneyExchange.Steps.CashInStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded" Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid Margin="64,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Style="{StaticResource HeaderText}" FontSize="{StaticResource FontSizeXLarge}"/>
                    <TextBlock x:Name="SubtitleText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeNormal}" Margin="0,10,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource PrimarySurfaceBrush}" CornerRadius="16" Padding="28,16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RateLabel" Foreground="{StaticResource TextSecondaryBrush}" FontSize="23" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtLiveRate" Foreground="{StaticResource PrimaryBrush}" FontSize="23" FontWeight="Bold" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="44">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="InsertedLabel" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="TxtInsertedForeign" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="68" FontWeight="Bold" Margin="0,4,0,36"/>

                        <TextBlock x:Name="EquivalentLabel" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="TxtEquivalentMyr" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="48" FontWeight="Bold" Margin="0,4,0,36"/>

                        <Border Background="{StaticResource PrimarySurfaceBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2" CornerRadius="18" Padding="36">
                            <StackPanel>
                                <TextBlock x:Name="PayableLabel" Foreground="{StaticResource PrimaryBrush}" FontSize="21" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtPayableMyr" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource PrimaryBrush}" FontSize="76" FontWeight="Black" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,36,0,0" HorizontalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="16" Height="16" Fill="{StaticResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatus" Foreground="{StaticResource TextSecondaryBrush}" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- FIX: this side used to just show a thin slot graphic and a
                     hint line, leaving most of the card empty (screenshots
                     11-13). Now shows a fuller acceptor illustration with a
                     visible feed direction and a supporting checklist -
                     genuinely useful guidance rather than decoration, fills
                     the card on purpose. The log events still fire the same
                     way (Svc_OnLog) - nothing in the code-behind's wiring
                     changes here, only the surrounding visual. -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="40">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="240" Height="150" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" CornerRadius="16" HorizontalAlignment="Center">
                            <Border Width="200" Height="12" Background="{StaticResource TextDisabledBrush}" CornerRadius="6" VerticalAlignment="Top" Margin="0,20,0,0"/>
                        </Border>
                        <TextBlock Text="⬇" FontSize="30" Foreground="{StaticResource AccentGoldBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"/>

                        <TextBlock x:Name="SlotHintText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="21" TextAlignment="Center" TextWrapping="Wrap" Margin="0,20,0,14" MaxWidth="320"/>

                        <!-- Accepted denominations - compact chip row instead
                             of a wrapped sentence, so it reads at a glance
                             rather than as a paragraph to parse. -->
                        <StackPanel x:Name="AcceptedDenomsPanel" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <TextBlock x:Name="AcceptedDenomsLabel" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="AcceptedDenomsChipsPanel" HorizontalAlignment="Center" MaxWidth="360"/>
                        </StackPanel>

                        <Border Background="{StaticResource BackgroundBrush}" CornerRadius="14" Padding="22,18" MaxWidth="340">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="✓" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Insert one note at a time" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="✓" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Keep notes flat and uncreased" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Wait for confirmation before the next note" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,28,0,0">
                <Button x:Name="BtnBack" Width="300" HorizontalAlignment="Left" Click="Back_Click" Style="{StaticResource OutlineButton}" Foreground="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerBrush}"/>
                <Button x:Name="BtnNext" Width="360" HorizontalAlignment="Right" IsEnabled="False" Click="Next_Click" Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Grid>

        <Border x:Name="EscrowOverlay" Visibility="Collapsed" Background="#CC121816" Panel.ZIndex="999">
            <Border Background="{StaticResource CardBrush}" CornerRadius="24" Padding="56" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="700">
                <StackPanel>
                    <TextBlock x:Name="NoteDetectedLabel" Foreground="{StaticResource TextSecondaryBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtEscrowAmount" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="60" FontWeight="Black" Margin="0,12,0,24" HorizontalAlignment="Center"/>

                    <!-- Made into a proper warning banner (tinted background,
                         bordered, icon) rather than plain colored text -
                         this decision (once accepted, a note is final) is
                         the one thing on this whole screen that must not be
                         missed, so it gets a distinct visual treatment, not
                         just bold text sitting among other text. -->
                    <Border Background="#22C9772E" BorderBrush="{StaticResource WarningBrush}" BorderThickness="2"
                            CornerRadius="14" Padding="24,18" Margin="0,0,0,32" MaxWidth="620" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="34" VerticalAlignment="Center" Margin="0,0,18,0"/>
                            <TextBlock x:Name="TxtEscrowDisclaimer" Foreground="{StaticResource WarningBrush}" FontSize="19" FontWeight="Bold"
                                       TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="480"/>
                        </StackPanel>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnEscrowReturn" Grid.Column="0" Click="EscrowReturn_Click" Style="{StaticResource OutlineButton}"/>
                        <Button x:Name="BtnEscrowAccept" Grid.Column="2" Click="EscrowAccept_Click" Style="{StaticResource PrimaryButton}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <Border x:Name="DoneOverlay" Visibility="Collapsed" Background="{StaticResource PrimaryBrush}" Panel.ZIndex="999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="✅" FontSize="104" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock x:Name="DoneTitle" Foreground="White" FontSize="48" FontWeight="Black" TextAlignment="Center"/>
                <TextBlock x:Name="DoneSubtitle" Foreground="#CFE3E0" FontSize="26" Margin="0,12,0,0" TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
