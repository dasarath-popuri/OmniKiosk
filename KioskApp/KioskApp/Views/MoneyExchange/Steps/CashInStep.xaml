<UserControl x:Class="OmniKiosk.Wpf.Views.MoneyExchange.Steps.CashInStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid Margin="36,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock x:Name="TitleText"
                           Style="{StaticResource HeaderText}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>

                <TextBlock x:Name="SubtitleText"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource FontSizeSmall}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="820"
                           HorizontalAlignment="Center"
                           Margin="0,7,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <!--<StackPanel MaxWidth="850" HorizontalAlignment="Center">-->
                <StackPanel HorizontalAlignment="Stretch">
                    <!-- Target / Rate summary -->
                    <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="YOUR TARGET"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock x:Name="TxtTargetForeign"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="28"
                                           FontWeight="Black"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="RateLabel"
                                           Text="Rate"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right"/>

                                <TextBlock x:Name="TxtLiveRate"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Right"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main accepted amount -->
                    <Border Style="{StaticResource Card}"
                            Padding="36"
                            Margin="0,0,0,16">

                        <StackPanel>
                            <TextBlock x:Name="InsertedLabel"
                                       Text="SUCCESSFULLY ACCEPTED"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="TxtInsertedForeign"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="68"
                                       FontWeight="Black"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,4"/>

                            <TextBlock x:Name="TxtRemainingForeign"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,18"/>

                            <ProgressBar x:Name="TargetProgressBar"
                                         Height="16"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"/>

                            <TextBlock x:Name="TxtProgressCaption"
                                       FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       Margin="0,6,0,22"/>

                            <!-- Compact payout row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{StaticResource BackgroundBrush}"
                                        CornerRadius="14"
                                        Padding="18">
                                    <StackPanel>
                                        <TextBlock x:Name="EquivalentLabel"
                                                   Text="EXACT CONVERSION"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock x:Name="TxtEquivalentMyr"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="27"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="{StaticResource PrimarySurfaceBrush}"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="14"
                                        Padding="18">
                                    <StackPanel>
                                        <TextBlock x:Name="PayableLabel"
                                                   Text="YOU WILL RECEIVE"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock x:Name="TxtPayableMyr"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="30"
                                                   FontWeight="Black"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Note insertion -->
                    <Border Style="{StaticResource Card}" Padding="34" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Insert your next note"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="SlotHintText"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="15"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       Margin="10,6,10,14"/>

                            <TextBlock Text="↓"
                                       FontSize="32"
                                       Foreground="{StaticResource AccentGoldBrush}"
                                       HorizontalAlignment="Center"/>

                            <Border Height="92"
                                    Background="{StaticResource BackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="14"
                                    Margin="30,8,30,22">

                                <Grid>
                                    <Border Width="210"
                                            Height="11"
                                            Background="{StaticResource TextDisabledBrush}"
                                            CornerRadius="6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Margin="0,18,0,0"/>

                                    <TextBlock Text="BANKNOTE ACCEPTOR"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,22,0,0"/>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="AcceptedDenomsPanel"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,16">

                                <TextBlock x:Name="AcceptedDenomsLabel"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,7"/>

                                <WrapPanel x:Name="AcceptedDenomsChipsPanel"
                                           HorizontalAlignment="Center"
                                           />
                            </StackPanel>

                            <Border Background="{StaticResource BackgroundBrush}"
                                    CornerRadius="12"
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="✓  Insert one note at a time"
                                               FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,7"/>

                                    <TextBlock Text="✓  Keep the banknote flat"
                                               FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,7"/>

                                    <TextBlock Text="✓  Wait for confirmation before inserting another note"
                                               FontSize="14"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Machine status -->
                    <Border Background="{StaticResource PrimarySurfaceBrush}"
                            CornerRadius="14"
                            Padding="16"
                            Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse x:Name="StatusDot"
                                     Width="13"
                                     Height="13"
                                     Fill="{StaticResource AccentBrush}"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"/>

                            <TextBlock x:Name="TxtStatus"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Fixed buttons -->
            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Button x:Name="BtnBack"
                        Width="280"
                        HorizontalAlignment="Left"
                        Click="Back_Click"
                        Style="{StaticResource OutlineButton}"
                        Foreground="{StaticResource DangerBrush}"
                        BorderBrush="{StaticResource DangerBrush}"/>

                <Button x:Name="BtnNext"
                        Width="430"
                        HorizontalAlignment="Right"
                        IsEnabled="False"
                        Click="Next_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Grid>

        <!-- Escrow -->
        <Border x:Name="EscrowOverlay"
                Visibility="Collapsed"
                Background="#D9121816"
                Panel.ZIndex="999">

            <Border Background="{StaticResource CardBrush}"
                    CornerRadius="24"
                    Padding="42"
                    Margin="70"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    MaxWidth="820">

                <StackPanel>
                    <TextBlock x:Name="NoteDetectedLabel"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="TxtEscrowAmount"
                               FontFamily="{StaticResource DisplayFont}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="54"
                               FontWeight="Black"
                               Margin="0,7,0,20"
                               HorizontalAlignment="Center"/>

                    <!-- What happens if accepted -->
                    <Border Background="{StaticResource BackgroundBrush}"
                            CornerRadius="14"
                            Padding="18"
                            Margin="0,0,0,20">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Accepted now"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtEscrowCurrentAccepted"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="After accepting"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtEscrowAfterAccept"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MYR payout"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtEscrowPayout"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Keep client-requested disclaimer prominent -->
                    <Border Background="#22C9772E"
                            BorderBrush="{StaticResource WarningBrush}"
                            BorderThickness="2.5"
                            CornerRadius="14"
                            Padding="22"
                            Margin="0,0,0,26">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="⚠️"
                                       FontSize="38"
                                       VerticalAlignment="Center"
                                       Margin="0,0,18,0"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="IMPORTANT"
                                           FontSize="19"
                                           FontWeight="Black"
                                           Foreground="{StaticResource WarningBrush}"
                                           Margin="0,0,0,4"/>

                                <TextBlock x:Name="TxtEscrowDisclaimer"
                                           Foreground="{StaticResource WarningBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnEscrowReturn"
                                Grid.Column="0"
                                Height="70"
                                Click="EscrowReturn_Click"
                                Style="{StaticResource OutlineButton}"/>

                        <Button x:Name="BtnEscrowAccept"
                                Grid.Column="2"
                                Height="70"
                                Click="EscrowAccept_Click"
                                Style="{StaticResource PrimaryButton}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Completing -->
        <Border x:Name="DoneOverlay"
                Visibility="Collapsed"
                Background="{StaticResource PrimaryBrush}"
                Panel.ZIndex="999">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="✓"
                           FontSize="96"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,18"/>

                <TextBlock x:Name="DoneTitle"
                           Foreground="White"
                           FontSize="44"
                           FontWeight="Black"
                           TextAlignment="Center"/>

                <TextBlock x:Name="DoneSubtitle"
                           Foreground="#CFE3E0"
                           FontSize="24"
                           Margin="0,10,0,0"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>