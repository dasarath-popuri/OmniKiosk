<UserControl x:Class="OmniKiosk.Wpf.Views.MoneyExchange.Steps.TermsAndConditionsStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded" Background="{StaticResource BackgroundBrush}">

    <Grid Margin="64,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,28" HorizontalAlignment="Center">
            <Border Background="{StaticResource AccentGoldLightBrush}" CornerRadius="18" Width="84" Height="84" HorizontalAlignment="Center" Margin="0,0,0,18">
                <TextBlock Text="📜" FontSize="46" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="TitleText" Style="{StaticResource HeaderText}" FontSize="{StaticResource FontSizeXLarge}" TextAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock x:Name="SubtitleText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeNormal}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- This card already stretches to fill the Star row (no extra
             centering wrapper collapsing it) - the fix here is scale and
             presence, not structure: bigger rows, more generous spacing,
             so the same content reads as confident rather than cramped. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="36">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <ItemsControl x:Name="TermsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BackgroundBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource PrimarySurfaceBrush}" CornerRadius="10" Width="44" Height="44" Margin="0,0,18,0">
                                            <TextBlock Text="{Binding Icon}" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="28"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{StaticResource AccentGoldLightBrush}" CornerRadius="18" Padding="24" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ConfirmHeaderText" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>
                            <ItemsControl x:Name="ConfirmList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="✓" FontSize="21" FontWeight="Bold" Foreground="{StaticResource AccentGoldBrush}" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="19" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,24,0,0">
            <Button x:Name="BtnBack" Width="220" HorizontalAlignment="Left" Click="Back_Click" Style="{StaticResource OutlineButton}"/>
            <Button x:Name="BtnNext" Width="280" HorizontalAlignment="Right" Click="Next_Click" Style="{StaticResource PrimaryButton}"/>
        </Grid>
    </Grid>
</UserControl>
