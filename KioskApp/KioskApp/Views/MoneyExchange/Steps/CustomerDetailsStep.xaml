<UserControl x:Class="OmniKiosk.Wpf.Views.MoneyExchange.Steps.CustomerDetailsStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded" Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- Passport: slides down onto the scanner bed, pauses, resets. Pure
             TranslateTransform + Opacity on plain shapes - same technique as
             the proven-safe cash-note animation in FinalReceiptStep, nothing
             video/bitmap based, so it can't reintroduce the lag we already
             fixed once on the camera screen. -->
        <Storyboard x:Key="PassportPlaceAnim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PassportTrans" Storyboard.TargetProperty="Y" From="0" To="78" Duration="0:0:0.9" BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ScannerGlow" Storyboard.TargetProperty="Opacity" From="0.4" To="1" Duration="0:0:0.3" BeginTime="0:0:0.9"/>
            <DoubleAnimation Storyboard.TargetName="ScannerGlow" Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.5" BeginTime="0:0:1.6"/>
            <DoubleAnimation Storyboard.TargetName="PassportTrans" Storyboard.TargetProperty="Y" From="78" To="0" Duration="0:0:0.6" BeginTime="0:0:2.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Card: slides horizontally into the reader slot, pauses, resets. -->
        <Storyboard x:Key="CardInsertAnim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="CardTrans" Storyboard.TargetProperty="X" From="0" To="-95" Duration="0:0:0.8" BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ReaderGlow" Storyboard.TargetProperty="Opacity" From="0.4" To="1" Duration="0:0:0.3" BeginTime="0:0:0.8"/>
            <DoubleAnimation Storyboard.TargetName="ReaderGlow" Storyboard.TargetProperty="Opacity" From="1" To="0.4" Duration="0:0:0.5" BeginTime="0:0:1.5"/>
            <DoubleAnimation Storyboard.TargetName="CardTrans" Storyboard.TargetProperty="X" From="-95" To="0" Duration="0:0:0.5" BeginTime="0:0:2.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <!-- On-screen numeric keypad key. Our own control instead of the
             Windows touch keyboard, so the mobile field can only ever show
             digits - no QWERTY, Tab, Ctrl or Windows key exposed to the
             customer, identical on every Windows build. -->
        <Style x:Key="KeypadKeyStyle" TargetType="Button">
            <Setter Property="Height" Value="84"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="KeyBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KeyBorder" Property="Background" Value="{StaticResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="60,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24" HorizontalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource HeaderText}" TextAlignment="Center"/>
                <TextBlock x:Name="SubtitleText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" Margin="0,8,0,0" TextAlignment="Center"/>
            </StackPanel>

            <!-- DOCUMENT TYPE SELECTION - "which document do you have", not tied
             to nationality, since a Malaysian can hold a passport too. -->
            <Grid x:Name="ViewSelection" Grid.Row="1" Visibility="Visible" MaxWidth="1200" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24" Cursor="Hand" Height="340" MouseDown="BtnIc_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🪪" FontSize="90" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock x:Name="IcTitle" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="IcSubtitle" Foreground="{StaticResource AccentGoldBrush}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24" Cursor="Hand" Height="340" MouseDown="BtnPassport_Click">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🛂" FontSize="90" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock x:Name="PassportTitle" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PassportSubtitle" Foreground="{StaticResource AccentGoldBrush}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- READING / SCANNING - animation + guidance text specific to which
             document was chosen. -->
            <Grid x:Name="ViewScanning" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center">
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="48" MaxWidth="800">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                        <!-- Passport placement stage -->
                        <Grid x:Name="PassportAnimStage" Width="260" Height="170" Visibility="Collapsed" Margin="0,0,0,28">
                            <Border x:Name="ScannerGlow" Width="220" Height="10" Background="{StaticResource AccentGoldBrush}" CornerRadius="5" VerticalAlignment="Bottom" Margin="0,0,0,44" Opacity="0.4"/>
                            <Border Width="240" Height="34" Background="{StaticResource TextPrimaryBrush}" CornerRadius="8" VerticalAlignment="Bottom"/>
                            <Border Width="130" Height="88" Background="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource AccentGoldBrush}" BorderThickness="3" CornerRadius="6" VerticalAlignment="Top">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="PassportTrans" Y="0"/>
                                </Border.RenderTransform>
                                <TextBlock Text="🛂" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Card insertion stage -->
                        <Grid x:Name="CardAnimStage" Width="260" Height="130" Visibility="Collapsed" Margin="0,0,0,28">
                            <Border Width="70" Height="90" Background="{StaticResource TextPrimaryBrush}" CornerRadius="8" HorizontalAlignment="Right">
                                <Border x:Name="ReaderGlow" Width="8" Height="60" Background="{StaticResource AccentGoldBrush}" CornerRadius="4" HorizontalAlignment="Left" Margin="10,0,0,0" Opacity="0.4"/>
                            </Border>
                            <Border Width="130" Height="82" Background="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource AccentGoldBrush}" BorderThickness="3" CornerRadius="6" HorizontalAlignment="Right" Margin="0,0,150,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="CardTrans" X="0"/>
                                </Border.RenderTransform>
                                <TextBlock Text="🪪" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="AutoReadStatus" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeSmall}" Margin="0,14,0,0" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RESULT - redesigned: photo stacked on top (portrait-friendly,
             uses the screen's vertical space instead of leaving it empty),
             fields in a clean 2-column grid with no dead cells, mobile
             number visually flagged as required (red asterisk + badge)
             since it gates BtnNext via UpdateNextEnabled() in the code-behind.
             Every x:Name the code-behind touches (TxtName, TxtIdNo, TxtNat,
             TxtGender, TxtDob, TxtExpiry, ExpiryPanel, ExpiryLabel,
             IdentityConfirmedText, DocNoLabel, NationalityLabel, GenderLabel,
             DobLabel, MobileLabel, TxtMobile, MobileHintText, PortraitImage)
             is preserved with the same type and the same event wiring -
             only the surrounding layout changed. -->
            <Grid x:Name="ViewResult" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center">
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="20" Padding="48,40" MaxWidth="860">
                    <StackPanel>

                        <!-- Photo + confirmation badge, centered as the visual anchor -->
                        <Border Width="220" Height="280" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" ClipToBounds="True" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <Image x:Name="PortraitImage" Stretch="UniformToFill"/>
                        </Border>

                        <Border Background="#E7F5EE" CornerRadius="20" Padding="18,7" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="15" Margin="0,0,7,0"/>
                                <TextBlock x:Name="IdentityConfirmedText" Foreground="{StaticResource AccentBrush}" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="TxtName" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,26"/>

                        <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,0,0,26"/>

                        <!-- Details - clean 2-column grid, every row fully populated -->
                        <Grid Margin="0,0,0,26">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock x:Name="DocNoLabel" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="TxtIdNo" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock x:Name="NationalityLabel" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="TxtNat" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock x:Name="GenderLabel" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="TxtGender" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock x:Name="DobLabel" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="TxtDob" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                            </StackPanel>

                            <Grid x:Name="ExpiryPanel" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock x:Name="ExpiryLabel" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtExpiry" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock x:Name="DateOfIssueLabel" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtDateOfIssue" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock x:Name="PlaceOfBirthLabel" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtPlaceOfBirth" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock x:Name="PlaceOfIssueLabel" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock x:Name="TxtPlaceOfIssue" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- Mobile number - visually flagged as required, since
                         UpdateNextEnabled() in the code-behind keeps Verify
                         Face disabled until this is filled in. -->
                        <Border Background="#FDF6F4" BorderBrush="#F0C7BC" BorderThickness="1" CornerRadius="14" Padding="22,18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock x:Name="MobileLabel" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="*" Foreground="#D64545" FontWeight="Bold" FontSize="16" Margin="4,0,0,0" VerticalAlignment="Top"/>
                                    <Border Background="#D64545" CornerRadius="8" Padding="9,2" Margin="10,-2,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="REQUIRED" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CboDialCode" Grid.Column="0" Width="150" Margin="0,0,10,0"
                                          Style="{StaticResource ModernComboBox}" SelectionChanged="CboDialCode_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <!--<Border Width="26" Height="18" CornerRadius="3" ClipToBounds="True" Margin="0,0,8,0">
                                                    <svgc:SvgViewbox Source="{Binding FlagUri}" Stretch="UniformToFill"/>
                                                </Border>-->
                                                    <Border Width="26" Height="18" CornerRadius="3" ClipToBounds="True" Margin="0,0,8,0">
                                                        <Image Source="{Binding FlagUri}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding DialCode}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <!-- Focusable="False" is what stops the Windows touch keyboard:
                                     it only auto-opens for a focused editable field. Tapping
                                     opens our own digits-only keypad (MobileKeypadOverlay). -->
                                    <TextBox x:Name="TxtMobile" Grid.Column="1" Style="{StaticResource ModernTextBox}" MaxLength="15"
                                         Focusable="False" IsReadOnly="True" Cursor="Hand"
                                         PreviewMouseLeftButtonDown="TxtMobile_Tap"
                                         TextChanged="TxtMobile_TextChanged" PreviewTextInput="TxtMobile_PreviewTextInput"/>
                                </Grid>
                                <TextBlock x:Name="MobileHintText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,24,0,0">
                <Button x:Name="BtnBack" Width="220" HorizontalAlignment="Left" Click="Back_Click" Style="{StaticResource OutlineButton}"/>
                <Button x:Name="BtnNext" Width="320" HorizontalAlignment="Right" IsEnabled="False" Visibility="Collapsed" Click="Next_Click" Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Grid>

        <!-- MOBILE NUMBER KEYPAD - dimmed full-screen overlay with a digits-only
         keypad docked at the bottom (the customer's hands are already low
         at the kiosk). Tapping the dimmed area outside the card closes it,
         same as Done. -->
        <Grid x:Name="MobileKeypadOverlay" Visibility="Collapsed" Background="#99000000" MouseLeftButtonDown="MobileKeypadOverlay_BackgroundTap">
            <Border Background="{StaticResource BackgroundBrush}" CornerRadius="24,24,0,0" Padding="36,28,36,36"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="640"
                MouseLeftButtonDown="MobileKeypadCard_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock x:Name="KeypadTitleText" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                    <!-- Readout: dial code + digits entered so far -->
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                        CornerRadius="14" Padding="22,14" Margin="6,0,6,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="KeypadDialCodeText" Grid.Column="0" FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock x:Name="KeypadDisplayText" Grid.Column="1" FontFamily="{StaticResource DisplayFont}" FontSize="34" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="KeypadPlaceholderText" Grid.Column="1" FontSize="22"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="KeypadHintText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <UniformGrid Columns="3" Rows="4">
                        <Button Content="1" Tag="1" Style="{StaticResource KeypadKeyStyle}" Click="KeypadDigit_Click"/>
                        <Button Content="2" Tag="2" Style="{StaticResource KeypadKeyStyle}" Click="KeypadDigit_Click"/>
                        <Button Content="3" Tag="3" Style="{StaticResource KeypadKeyStyle}" Click="KeypadDigit_Click"/>
                        <Button Content="4" Tag="4" Style="{StaticResource KeypadKeyStyle}" Click="KeypadDigit_Click"/>
                        <Button Content="5" Tag="5" Style="{StaticResource KeypadKeyStyle}" Click="KeypadDigit_Click"/>
                        <Button Content="6" Tag="6" Style="{StaticResource KeypadKeyStyle}" Click="KeypadDigit_Click"/>
                        <Button Content="7" Tag="7" Style="{StaticResource KeypadKeyStyle}" Click="KeypadDigit_Click"/>
                        <Button Content="8" Tag="8" Style="{StaticResource KeypadKeyStyle}" Click="KeypadDigit_Click"/>
                        <Button Content="9" Tag="9" Style="{StaticResource KeypadKeyStyle}" Click="KeypadDigit_Click"/>
                        <Button x:Name="KeypadClearButton" FontSize="20" Style="{StaticResource KeypadKeyStyle}" Click="KeypadClear_Click"/>
                        <Button Content="0" Tag="0" Style="{StaticResource KeypadKeyStyle}" Click="KeypadDigit_Click"/>
                        <Button Content="⌫" FontSize="30" Style="{StaticResource KeypadKeyStyle}" Click="KeypadBackspace_Click"/>
                    </UniformGrid>

                    <Button x:Name="KeypadDoneButton" Style="{StaticResource PrimaryButton}" Height="76" Margin="6,16,6,0"
                        Focusable="False" Click="KeypadDone_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
